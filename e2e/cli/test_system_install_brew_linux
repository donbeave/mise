#!/usr/bin/env bash
# e2e:writable-rootfs

# Linuxbrew pour test: the dedicated job runs this as root in the e2e
# container's fresh writable rootfs and fresh /home bind mount. The host's
# /home/linuxbrew is never a mutation target.
if [[ $(uname) != Linux ]]; then
  echo "SKIP: brew formula oracle requires Linux" >&2
  exit 0
fi
[[ $(id -u) == 0 ]] || {
  echo "brew oracle safety check failed: Linux oracle must run as root" >&2
  exit 1
}
case "$(uname -m)" in
  x86_64 | aarch64) ;;
  *)
    echo "SKIP: unsupported Linux architecture for brew oracle" >&2
    exit 0
    ;;
esac

# shellcheck source=e2e/cli/brew_oracle_guard.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle_guard.sh"
# shellcheck source=e2e/cli/brew_oracle.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle.sh"
brew_oracle_require_disposable linux-formula /home/linuxbrew/.linuxbrew

linuxbrew_home_existed=0
linuxbrew_home_mode=
if [[ -L /home/linuxbrew ]]; then
  brew_oracle_fail "Linuxbrew home is a symlink"
elif [[ -e /home/linuxbrew ]]; then
  [[ -d /home/linuxbrew ]] || brew_oracle_fail "Linuxbrew home is not a directory"
  [[ $(stat -c %u:%g /home/linuxbrew) == 0:0 ]] ||
    brew_oracle_fail "Linuxbrew home is not root-owned"
  ! mountpoint -q /home/linuxbrew || brew_oracle_fail "Linuxbrew home is a mount point"
  [[ -z $(find /home/linuxbrew -mindepth 1 -maxdepth 1 -print -quit) ]] ||
    brew_oracle_fail "ambiguous non-empty Linuxbrew home"
  linuxbrew_home_existed=1
  linuxbrew_home_mode=$(stat -c %a /home/linuxbrew)
fi
if getent passwd linuxbrew >/dev/null 2>&1; then
  brew_oracle_fail "pre-existing linuxbrew user is ambiguous"
fi
# Do not inspect process command lines: this oracle's own shell and awk source
# contain the literal canonical prefix and therefore self-match. Inspect live
# kernel path references instead, excluding this shell and its parent.
for proc in /proc/[0-9]*; do
  pid=${proc##*/}
  [[ $pid != "$$" && $pid != "$PPID" ]] || continue
  for proc_link in "$proc/cwd" "$proc/exe" "$proc/root" "$proc"/fd/*; do
    [[ -L $proc_link ]] || continue
    proc_target=$(readlink -f "$proc_link" 2>/dev/null || true)
    case "$proc_target" in
      /home/linuxbrew/.linuxbrew | /home/linuxbrew/.linuxbrew/*)
        brew_oracle_fail "process $pid references the Linuxbrew prefix through $proc_link"
        ;;
    esac
  done
done

{
  printf 'existed=%s\n' "$linuxbrew_home_existed"
  printf 'mode=%s\n' "${linuxbrew_home_mode:-absent}"
  printf 'owner=%s\n' "$(stat -c %u:%g /home/linuxbrew 2>/dev/null || printf absent)"
} >"$MISE_BREW_ORACLE_RESULT_DIR/linux-home.preexisting"

cleanup_linuxbrew_home() {
  userdel linuxbrew 2>/dev/null || true
  rm -rf /home/linuxbrew
  if [[ $linuxbrew_home_existed == 1 ]]; then
    install -d -m "$linuxbrew_home_mode" -o root -g root /home/linuxbrew
  fi
}
trap cleanup_linuxbrew_home EXIT

useradd --create-home --home-dir /home/linuxbrew linuxbrew
installer_commit=a34ae4ee9151cbce4c3b33bca7043a972b7ae9a5
installer_sha256=12479a24be3f5307eecac7cde670fad7118640f031229e964f544b1367b52a41
curl -fsSL "https://raw.githubusercontent.com/Homebrew/install/$installer_commit/install.sh" \
  -o /home/linuxbrew/install-homebrew.sh
printf '%s  %s\n' "$installer_sha256" /home/linuxbrew/install-homebrew.sh | shasum -a 256 -c -
chown linuxbrew:linuxbrew /home/linuxbrew/install-homebrew.sh
runuser -u linuxbrew -- env NONINTERACTIVE=1 CI=1 \
  bash /home/linuxbrew/install-homebrew.sh
brew=/home/linuxbrew/.linuxbrew/bin/brew
mise_bin=$(command -v mise)
mise_as_linuxbrew="runuser -u linuxbrew -- env HOME=/home/linuxbrew XDG_CACHE_HOME=/home/linuxbrew/.cache '$mise_bin'"

cat <<EOF >mise.toml
[bootstrap.packages]
"brew:xz" = "latest"
EOF
chown linuxbrew:linuxbrew "$PWD" mise.toml

# Real Homebrew baseline in disposable state.
runuser -u linuxbrew -- "$brew" install --formula xz --yes
brew_keg=$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)
brew_oracle_snapshot brew-xz.snapshot "keg=$brew_keg"
runuser -u linuxbrew -- "$brew" uninstall --formula xz --yes
assert_fail "test -e /home/linuxbrew/.linuxbrew/opt/xz"
assert_fail "test -L /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz"

# Engine state must be indistinguishable after explicit volatile normalization.
assert_contains "$mise_as_linuxbrew bootstrap packages status" "missing"
runuser -u linuxbrew -- env HOME=/home/linuxbrew XDG_CACHE_HOME=/home/linuxbrew/.cache \
  "$mise_bin" bootstrap packages apply --yes
mise_keg=$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)
brew_oracle_snapshot mise-xz.snapshot "keg=$mise_keg"
brew_oracle_diff brew-xz.snapshot mise-xz.snapshot
assert_contains "runuser -u linuxbrew -- '$brew' list --formula" "xz"
assert_succeed "runuser -u linuxbrew -- '$brew' info xz"
runuser -u linuxbrew -- "$brew" uninstall --formula xz --yes
assert_fail "test -e /home/linuxbrew/.linuxbrew/opt/xz"

# Brew-installed state is an engine no-op and remains byte-identical.
runuser -u linuxbrew -- "$brew" install --formula xz --yes
brew_oracle_snapshot before-noop.snapshot "keg=$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)"
assert_contains "$mise_as_linuxbrew bootstrap packages status" "installed"
assert_contains "$mise_as_linuxbrew bootstrap packages apply --yes 2>&1" "already"
brew_oracle_snapshot after-noop.snapshot "keg=$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)"
brew_oracle_diff before-noop.snapshot after-noop.snapshot
runuser -u linuxbrew -- "$brew" uninstall --formula xz --yes

# Keep repair/import/prune coverage on engine-installed state.
runuser -u linuxbrew -- env HOME=/home/linuxbrew XDG_CACHE_HOME=/home/linuxbrew/.cache \
  "$mise_bin" bootstrap packages apply --yes
keg=$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)
receipt_mtime=$(stat -c %y "$keg/INSTALL_RECEIPT.json")
keg_inode=$(stat -c %i "$keg")
public_link_inode=$(stat -c %i /home/linuxbrew/.linuxbrew/bin/xz)
rm /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz
assert_contains "$mise_as_linuxbrew bootstrap packages status" "needs repair"
runuser -u linuxbrew -- env HOME=/home/linuxbrew XDG_CACHE_HOME=/home/linuxbrew/.cache \
  "$mise_bin" bootstrap packages apply --yes
assert_succeed "test \"$(readlink -f /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz)\" = \"$keg\""
assert_succeed "test \"$(stat -c %y "$keg/INSTALL_RECEIPT.json")\" = \"$receipt_mtime\""
assert_succeed "test \"$(stat -c %i "$keg")\" = \"$keg_inode\""
assert_succeed "test \"$(stat -c %i /home/linuxbrew/.linuxbrew/bin/xz)\" = \"$public_link_inode\""

rm /home/linuxbrew/.linuxbrew/opt/xz
assert_contains "$mise_as_linuxbrew bootstrap packages status" "needs repair"
runuser -u linuxbrew -- env HOME=/home/linuxbrew XDG_CACHE_HOME=/home/linuxbrew/.cache \
  "$mise_bin" bootstrap packages apply --yes
assert_succeed "test \"$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)\" = \"$keg\""

assert_contains "$mise_as_linuxbrew bootstrap packages import --manager brew --dry-run --path imported.toml" '"brew:xz" = "latest"'
runuser -u linuxbrew -- env HOME=/home/linuxbrew XDG_CACHE_HOME=/home/linuxbrew/.cache \
  "$mise_bin" bootstrap packages import --manager brew --path imported.toml
assert_contains "cat imported.toml" '"brew:xz" = "latest"'
assert_contains "$mise_as_linuxbrew bootstrap packages prune --manager brew --dry-run 2>&1" "nothing to prune"

cat <<EOF >mise.toml
[bootstrap.packages]
EOF
assert_contains "$mise_as_linuxbrew bootstrap packages prune --manager brew --dry-run" "remove brew:xz"
runuser -u linuxbrew -- env HOME=/home/linuxbrew XDG_CACHE_HOME=/home/linuxbrew/.cache \
  "$mise_bin" bootstrap packages prune --manager brew --yes
assert_fail "test -e /home/linuxbrew/.linuxbrew/opt/xz"
assert_fail "test -L /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz"

brew_oracle_complete test_system_install_brew_linux 1 /home/linuxbrew/.linuxbrew
