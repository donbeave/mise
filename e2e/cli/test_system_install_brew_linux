mise_archive_keg=$(readlink -f /home/linuxbrew/.linuxbrew/opt/archive-fixture)
assert_contains "'$mise_archive_keg/bin/archive-fixture'" "archive-fixture 1.0.0"
assert_contains "cat '$mise_archive_keg/INSTALL_RECEIPT.json'" '"poured_from_bottle": true'
brew_oracle_snapshot "$MISE_BREW_ORACLE_RESULT_DIR/mise-archive.snapshot" \
  "keg=$mise_archive_keg"
assert_contains "runuser -u linuxbrew -- '$brew' list --formula" "archive-fixture"
assert_succeed "runuser -u linuxbrew -- '$brew' info mise/oracle/archive-fixture"
runuser -u linuxbrew -- "$brew" uninstall --formula archive-fixture
assert_fail "test -e /home/linuxbrew/.linuxbrew/opt/archive-fixture"

runuser -u linuxbrew -- "$brew" install --force-bottle mise/oracle/archive-fixture
brew_archive_keg=$(readlink -f /home/linuxbrew/.linuxbrew/opt/archive-fixture)
brew_oracle_snapshot "$MISE_BREW_ORACLE_RESULT_DIR/brew-archive.snapshot" \
  "keg=$brew_archive_keg"
brew_oracle_diff \
  "$MISE_BREW_ORACLE_RESULT_DIR/brew-archive.snapshot" \
  "$MISE_BREW_ORACLE_RESULT_DIR/mise-archive.snapshot"
assert_contains "$mise_archive bootstrap packages status" "installed"
assert_contains "$mise_archive bootstrap packages apply --yes 2>&1" "already"
assert_contains "'$brew_archive_keg/bin/archive-fixture'" "archive-fixture 1.0.0"
runuser -u linuxbrew -- "$brew" uninstall --formula archive-fixture
assert_fail "test -e /home/linuxbrew/.linuxbrew/opt/archive-fixture"

# Linux cask configuration and moved-font topology must match the pinned
# implementation under a non-default XDG data root in both ownership
# directions. The native config snapshot also carries Linux app/VST defaults.
linux_font_xdg=/home/linuxbrew/oracle-xdg-data
linux_font_dir="$linux_font_xdg/fonts"
linux_font_room=/home/linuxbrew/.linuxbrew/Caskroom/font-jetbrains-mono
mise_font_as_linuxbrew="HOMEBREW_XDG_DATA_HOME='$linux_font_xdg' run_mise_as_linuxbrew"

snapshot_linux_font() {
  local output="$MISE_BREW_ORACLE_RESULT_DIR/$1" font index=0
  local roots=("caskroom=$linux_font_room")
  while IFS= read -r font; do
    roots+=("font-$index=$font")
    index=$((index + 1))
  done < <(find "$linux_font_dir" -type f -name 'JetBrainsMono*' -print | LC_ALL=C sort)
  [[ $index -gt 0 ]] || brew_oracle_fail "Linux font cask installed zero fonts"
  brew_oracle_snapshot "$output" "${roots[@]}"
}

