EOF
git -C "$archive_tap" init
git -C "$archive_tap" remote add origin https://github.com/mise/homebrew-oracle.git
git -C "$archive_tap" add Formula/archive-fixture.rb
git -C "$archive_tap" -c user.name=oracle -c user.email=oracle@example.invalid \
  commit -m 'test: add archive fixture'
archive_tap_sha=$(git -C "$archive_tap" rev-parse HEAD)
chown -R linuxbrew:linuxbrew "$archive_root" "$archive_tap"
printf 'formula:archive-fixture version=1.0.0 bottle_sha256=%s tap_sha=%s\n' \
  "$archive_sha" "$archive_tap_sha" \
  >>"$MISE_BREW_ORACLE_RESULT_DIR/api-fixtures.txt"

archive_replacements="{\"https://raw.githubusercontent.com/mise/homebrew-oracle/HEAD/api/formula/archive-fixture.json\":\"http://127.0.0.1:$archive_port/archive-fixture.json\"}"
cat <<EOF >mise.toml
[bootstrap.brew.taps]
"mise/oracle" = "https://github.com/mise/homebrew-oracle.git"

[bootstrap.packages]
"brew:mise/oracle/archive-fixture" = "latest"
EOF
chown linuxbrew:linuxbrew mise.toml
mkdir "$archive_root/no-compiler"
cat <<'EOF' >"$archive_root/no-compiler/cc"
