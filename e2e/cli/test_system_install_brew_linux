cat <<'EOF' >"$archive_payload/sbom.spdx.json"
{
  "spdxVersion": "SPDX-2.3",
  "dataLicense": "CC0-1.0",
  "SPDXID": "SPDXRef-DOCUMENT",
  "name": "archive-fixture-1.0.0",
  "documentNamespace": "https://mise.jdx.dev/oracle/archive-fixture-1.0.0",
  "creationInfo": {
    "created": "2026-08-13T00:00:00Z",
    "creators": ["Tool: https://github.com/Homebrew/brew@6.0.17"]
  },
  "packages": [{
    "name": "archive-fixture",
    "SPDXID": "SPDXRef-Package-archive-fixture",
    "versionInfo": "1.0.0",
