    "filesAnalyzed": false
  }]
}
EOF
tar -C "$archive_root/payload" -czf "$archive_root/$archive_name" archive-fixture
# Homebrew derives the download basename from this local tap's canonical URL,
# while mise consumes the exact API bottle URL. Serve the same immutable bytes
# under both engine-derived names so the oracle compares provenance, not URL
# naming policy.
ln "$archive_root/$archive_name" "$archive_root/$archive_brew_name"
archive_sha=$(shasum -a 256 "$archive_root/$archive_name" | awk '{print $1}')
cat <<'PY' >"$archive_root/server.py"
import http.server
import pathlib
import socketserver
import sys

root = pathlib.Path(sys.argv[1])
port_file = pathlib.Path(sys.argv[2])
handler = lambda *args, **kwargs: http.server.SimpleHTTPRequestHandler(
    *args, directory=root, **kwargs
)
with socketserver.TCPServer(("127.0.0.1", 0), handler) as server:
    port_file.write_text(str(server.server_address[1]))
    server.serve_forever()
PY
python3 "$archive_root/server.py" "$archive_root" "$archive_root/port" \
  >"$MISE_BREW_ORACLE_RESULT_DIR/archive-server.log" 2>&1 &
archive_server_pid=$!
for _ in {1..50}; do
  [[ -s $archive_root/port ]] && break
  sleep 0.1
done
[[ -s $archive_root/port ]] || brew_oracle_fail "archive bottle server did not start"
archive_port=$(cat "$archive_root/port")
archive_url="http://127.0.0.1:$archive_port/$archive_name"

cat <<EOF >"$archive_tap/Formula/archive-fixture.rb"
