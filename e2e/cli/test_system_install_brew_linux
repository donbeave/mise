mise_archive="MISE_URL_REPLACEMENTS='$archive_replacements' PATH='$archive_root/no-compiler:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin' run_mise_as_linuxbrew"
assert_contains "$mise_archive bootstrap packages status" "missing"
MISE_URL_REPLACEMENTS="$archive_replacements" \
