#!/usr/bin/env bash

if [[ "$(uname)" != "Darwin" ]] || [[ "$(uname -m)" != "arm64" ]]; then
  echo "SKIP: formula lifecycle oracle requires macOS arm64" >&2
  exit 0
fi

# shellcheck source=e2e/cli/brew_oracle_guard.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle_guard.sh"
# shellcheck source=e2e/cli/brew_oracle.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle.sh"
export MISE_SYSTEM_BREW_PREFIX="${MISE_BREW_LIFECYCLE_TEST_PREFIX:-}"
brew_oracle_require_disposable macos-formula-lifecycle /opt/homebrew
[[ $MISE_SYSTEM_BREW_PREFIX == "$BREW_ORACLE_EXPECTED_PREFIX" ]] ||
  brew_oracle_fail "formula lifecycle oracle requires explicit canonical /opt/homebrew prefix"
brew_oracle_configure_runtime "$MISE_SYSTEM_BREW_PREFIX"
brew=$BREW_ORACLE_BREW

formula_fixtures=(ca-certificates openssl@3 node kimi-code)
unsupported_current_formula=postgresql@17
shared_fixture_paths=(
  "$MISE_SYSTEM_BREW_PREFIX/etc/ca-certificates"
  "$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3"
)
postgresql_var="$MISE_SYSTEM_BREW_PREFIX/var/postgresql@17"
preexisting_record="$MISE_BREW_ORACLE_RESULT_DIR/macos-formula-lifecycle.preexisting"

brew_oracle_record_api_fixture formula ca-certificates 2026-08-13 \
  e04c5e309cf46f8b56ea948dd184aca2ae64cd78e15c9fe15e43dd3a44c4f828
brew_oracle_record_api_fixture formula openssl@3 3.6.3 \
  13a19dd3df8d702d1700cdbdfe476675ea4944d862b1cfab2b5aba7920e1f47f
brew_oracle_record_api_fixture formula node 26.7.0 \
  ef137f5d70e97b399ea64f6e9c04c07994cea8a0db492142922c9d77fb789a8e
brew_oracle_record_api_fixture formula kimi-code 0.35.0 \
  2b1aea8a594f340dadec2ea105dd8afd032f725c410b5c697b17703c1800747e
brew_oracle_record_api_fixture formula postgresql@17 17.10 \
  30b784b24892ca2b76c4fa787a388ede791842e41875e85d6b2dadfc6f50d1f9

{
  printf 'prefix=%s\n' "$("$brew" --prefix)"
  for formula in "${formula_fixtures[@]}"; do
    "$brew" list --versions "$formula" 2>/dev/null || true
  done
  "$brew" list --versions "$unsupported_current_formula" 2>/dev/null || true
  for path in "${shared_fixture_paths[@]}"; do
    if [[ -e $path || -L $path ]]; then
      ls -ld "$path"
    fi
  done
  if [[ -e $postgresql_var || -L $postgresql_var ]]; then
    ls -ld "$postgresql_var"
  fi
} >"$preexisting_record"

cleanup_formula_fixtures() {
  local formula path
  for formula in "${formula_fixtures[@]}"; do
    # These exact formulae are the recorded fixtures on a disposable runner.
    # Ignore reverse dependencies so Homebrew cannot leave a fixture installed
    # merely because another preloaded runner formula refers to it.
    "$brew" uninstall --formula --force --ignore-dependencies "$formula" >/dev/null 2>&1 || true
  done
  "$brew" uninstall --formula --force --ignore-dependencies \
    "$unsupported_current_formula" >/dev/null 2>&1 || true
  for path in "${shared_fixture_paths[@]}"; do
    rm -rf "$path"
  done
  rm -rf "$postgresql_var"
}

stop_kimi_login() {
  local pid=${kimi_login_pid:-}
  local signal
  [[ -n $pid ]] || return 0
  for signal in INT TERM KILL; do
    kill -"$signal" "$pid" 2>/dev/null || break
    for _ in {1..20}; do
      kill -0 "$pid" 2>/dev/null || break 2
      sleep 0.1
    done
  done
  wait "$pid" 2>/dev/null || true
  unset kimi_login_pid
}

cleanup_formula_oracle() {
  stop_kimi_login
  cleanup_formula_fixtures
  brew_oracle_remove_runtime_bridge
}

# The explicit capability authorizes displacement of these exact fixtures on
# this ephemeral runner. The record above makes that displacement auditable.
cleanup_formula_fixtures
trap cleanup_formula_oracle EXIT

for formula in "${formula_fixtures[@]}"; do
  [[ ! -e $MISE_SYSTEM_BREW_PREFIX/Cellar/$formula ]] ||
    brew_oracle_fail "failed to prepare fresh formula fixture: $formula"
  [[ ! -e $MISE_SYSTEM_BREW_PREFIX/opt/$formula && ! -L $MISE_SYSTEM_BREW_PREFIX/opt/$formula ]] ||
    brew_oracle_fail "stale opt record remains for $formula"
  [[ ! -e $MISE_SYSTEM_BREW_PREFIX/var/homebrew/linked/$formula && ! -L $MISE_SYSTEM_BREW_PREFIX/var/homebrew/linked/$formula ]] ||
    brew_oracle_fail "stale linked-keg record remains for $formula"
done

# An already-current formula whose API uses unsupported lifecycle operations is
# outside the mutation set and cannot block an unrelated Kimi installation.
"$brew" install "$unsupported_current_formula"
cat <<EOF >mise.toml
[bootstrap.packages]
"brew:$unsupported_current_formula" = "latest"
"brew:kimi-code" = "latest"
EOF
mise bootstrap packages apply --yes
assert_contains "mise bootstrap packages status" "installed"
assert_succeed "test -x '$MISE_SYSTEM_BREW_PREFIX/bin/kimi'"
cleanup_formula_fixtures
for formula in "${formula_fixtures[@]}" "$unsupported_current_formula"; do
  [[ ! -e $MISE_SYSTEM_BREW_PREFIX/Cellar/$formula ]] ||
    brew_oracle_fail "exact Homebrew failed to remove mise-owned fixture: $formula"
  [[ ! -e $MISE_SYSTEM_BREW_PREFIX/opt/$formula && ! -L $MISE_SYSTEM_BREW_PREFIX/opt/$formula ]] ||
    brew_oracle_fail "stale opt record remains after cross-engine removal: $formula"
  [[ ! -e $MISE_SYSTEM_BREW_PREFIX/var/homebrew/linked/$formula && ! -L $MISE_SYSTEM_BREW_PREFIX/var/homebrew/linked/$formula ]] ||
    brew_oracle_fail "stale linked-keg remains after cross-engine removal: $formula"
done

snapshot_formula_chain() {
  local output=$1 formula keg
  output="$MISE_BREW_ORACLE_RESULT_DIR/$output"
  local roots=()
  for formula in "${formula_fixtures[@]}"; do
    keg=$(readlink -f "$MISE_SYSTEM_BREW_PREFIX/opt/$formula")
    roots+=("formula-$formula=$keg")
  done
  roots+=(
    "shared-ca=$MISE_SYSTEM_BREW_PREFIX/etc/ca-certificates"
    "shared-openssl=$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3"
  )
  brew_oracle_snapshot "$output" "${roots[@]}"
}

assert_formula_runtime() {
  local forbidden_ca_override
  assert_succeed "test -r '$MISE_SYSTEM_BREW_PREFIX/etc/ca-certificates/cert.pem'"
  assert_succeed "test -r '$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3/openssl.cnf'"
  assert_succeed "test -L '$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3/cert.pem'"
  assert_contains "readlink '$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3/cert.pem'" "ca-certificates/cert.pem"
  assert_succeed "test -x '$MISE_SYSTEM_BREW_PREFIX/opt/node/bin/node'"
  assert_succeed "test -x '$MISE_SYSTEM_BREW_PREFIX/bin/kimi'"
  for forbidden_ca_override in \
    SSL_CERT_FILE SSL_CERT_DIR NODE_EXTRA_CA_CERTS NODE_OPTIONS \
    NODE_TLS_REJECT_UNAUTHORIZED; do
    ! printenv "$forbidden_ca_override" >/dev/null 2>&1 ||
      brew_oracle_fail "forbidden CA/TLS override is present: $forbidden_ca_override"
  done
  assert_succeed "'$MISE_SYSTEM_BREW_PREFIX/opt/openssl@3/bin/openssl' s_client -verify_return_error -connect auth.kimi.com:443 -servername auth.kimi.com </dev/null"
  assert_succeed "'$MISE_SYSTEM_BREW_PREFIX/opt/node/bin/node' -e 'fetch(\"https://auth.kimi.com/api/oauth/device_authorization\").then(r => { if (r.status !== 405) process.exit(1) })'"
  assert_succeed "'$MISE_SYSTEM_BREW_PREFIX/bin/kimi' --version"
}

assert_kimi_login_tls() {
  local kimi_login_home="$TMPDIR/kimi-login-home"
  local kimi_login_log="$TMPDIR/kimi-login.log"
  local reached_device_code=0

  rm -rf "$kimi_login_home" "$kimi_login_log"
  KIMI_CODE_HOME="$kimi_login_home" \
    "$MISE_SYSTEM_BREW_PREFIX/bin/kimi" login >"$kimi_login_log" 2>&1 &
  kimi_login_pid=$!
  for _ in {1..200}; do
    if grep -Fq "Opening browser for Kimi device login:" "$kimi_login_log"; then
      reached_device_code=1
      break
    fi
    kill -0 "$kimi_login_pid" 2>/dev/null || break
    sleep 0.1
  done
  if [[ $reached_device_code != 1 ]]; then
    stop_kimi_login
    brew_oracle_fail "Kimi login did not reach TLS-backed device authorization"
    return 1
  fi
  stop_kimi_login
  rm -rf "$kimi_login_home" "$kimi_login_log"
}

cat <<'EOF' >mise.toml
[bootstrap.packages]
"brew:kimi-code" = "latest"
EOF

mise bootstrap --yes
assert_contains "mise bootstrap packages status" "installed"
assert_formula_runtime
snapshot_formula_chain mise-formula-chain.snapshot

# Reproduce the old mise dependency state reached from the one configured root:
# valid keg/receipt/opt, missing linked-keg, retained .bottle/etc, missing shared
# etc, skipped post-install, and no lifecycle record. Status must find the
# broken dependency offline and remain read-only. Top-level bootstrap then
# repairs it without replacing unrelated topology.
openssl_keg=$(readlink -f "$MISE_SYSTEM_BREW_PREFIX/opt/openssl@3")
assert_succeed "test -d '$openssl_keg/.bottle/etc/openssl@3'"
openssl_lifecycle_state=$(grep -lF "$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3" \
  "$MISE_STATE_DIR"/brew-formula-lifecycle/*.json)
[[ $(printf '%s\n' "$openssl_lifecycle_state" | grep -c .) == 1 ]] ||
  brew_oracle_fail "expected exactly one OpenSSL lifecycle state record"
openssl_keg_inode=$(stat -f '%i' "$openssl_keg")
openssl_receipt_inode=$(stat -f '%i' "$openssl_keg/INSTALL_RECEIPT.json")
openssl_opt_inode=$(stat -f '%i' "$MISE_SYSTEM_BREW_PREFIX/opt/openssl@3")
openssl_public_inode=$(stat -f '%i' "$MISE_SYSTEM_BREW_PREFIX/bin/openssl")
openssl_receipt_sha=$(shasum -a 256 "$openssl_keg/INSTALL_RECEIPT.json" | awk '{print $1}')
rm "$MISE_SYSTEM_BREW_PREFIX/var/homebrew/linked/openssl@3"
rm -rf "$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3"
rm "$openssl_lifecycle_state"
legacy_status=$(mise bootstrap packages status 2>&1)
printf '%s\n' "$legacy_status" >"$MISE_BREW_ORACLE_RESULT_DIR/legacy-status.txt"
for expected in \
  "dependency openssl@3" \
  "linked-keg record" \
  "lifecycle state absent" \
  "shared lifecycle path missing"; do
  grep -F "$expected" <<<"$legacy_status" >/dev/null ||
    brew_oracle_fail "legacy status omitted: $expected"
done
[[ $(stat -f '%i' "$openssl_keg") == "$openssl_keg_inode" ]]
[[ $(stat -f '%i' "$openssl_keg/INSTALL_RECEIPT.json") == "$openssl_receipt_inode" ]]
[[ $(stat -f '%i' "$MISE_SYSTEM_BREW_PREFIX/opt/openssl@3") == "$openssl_opt_inode" ]]
[[ $(stat -f '%i' "$MISE_SYSTEM_BREW_PREFIX/bin/openssl") == "$openssl_public_inode" ]]
[[ $(shasum -a 256 "$openssl_keg/INSTALL_RECEIPT.json" | awk '{print $1}') == "$openssl_receipt_sha" ]]
assert_fail "test -e '$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3'"
assert_fail "test -e '$MISE_SYSTEM_BREW_PREFIX/var/homebrew/linked/openssl@3'"

mise bootstrap --yes
[[ $(stat -f '%i' "$openssl_keg") == "$openssl_keg_inode" ]]
[[ $(stat -f '%i' "$openssl_keg/INSTALL_RECEIPT.json") == "$openssl_receipt_inode" ]]
[[ $(stat -f '%i' "$MISE_SYSTEM_BREW_PREFIX/opt/openssl@3") == "$openssl_opt_inode" ]]
[[ $(stat -f '%i' "$MISE_SYSTEM_BREW_PREFIX/bin/openssl") == "$openssl_public_inode" ]]
[[ $(shasum -a 256 "$openssl_keg/INSTALL_RECEIPT.json" | awk '{print $1}') == "$openssl_receipt_sha" ]]
assert_formula_runtime
assert_kimi_login_tls

# The same legacy repair is not guessed when its authoritative formula source
# no longer matches. Apply must fail before touching the valid receipt/shared
# state and name the exact reinstall requirement.
openssl_lifecycle_state=$(grep -lF "$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3" \
  "$MISE_STATE_DIR"/brew-formula-lifecycle/*.json)
[[ $(printf '%s\n' "$openssl_lifecycle_state" | grep -c .) == 1 ]] ||
  brew_oracle_fail "expected exactly one repaired OpenSSL lifecycle state record"
cp -p "$openssl_lifecycle_state" "$MISE_BREW_ORACLE_RESULT_DIR/openssl-lifecycle-state.json"
cp -p "$openssl_keg/.brew/openssl@3.rb" "$MISE_BREW_ORACLE_RESULT_DIR/openssl@3.rb"
rm "$openssl_lifecycle_state"
printf '\n# ambiguous legacy source\n' >>"$openssl_keg/.brew/openssl@3.rb"
ambiguous_shared_sha=$(shasum -a 256 "$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3/openssl.cnf" | awk '{print $1}')
if mise bootstrap --yes >"$MISE_BREW_ORACLE_RESULT_DIR/legacy-ambiguous.txt" 2>&1; then
  brew_oracle_fail "ambiguous legacy formula source was repaired"
fi
grep -F "requires reinstall: formula snapshot checksum does not match" \
  "$MISE_BREW_ORACLE_RESULT_DIR/legacy-ambiguous.txt" >/dev/null ||
  brew_oracle_fail "ambiguous legacy failure omitted exact reinstall requirement"
[[ $(shasum -a 256 "$openssl_keg/INSTALL_RECEIPT.json" | awk '{print $1}') == "$openssl_receipt_sha" ]]
[[ $(shasum -a 256 "$MISE_SYSTEM_BREW_PREFIX/etc/openssl@3/openssl.cnf" | awk '{print $1}') == "$ambiguous_shared_sha" ]]
cp -p "$MISE_BREW_ORACLE_RESULT_DIR/openssl@3.rb" "$openssl_keg/.brew/openssl@3.rb"
cp -p "$MISE_BREW_ORACLE_RESULT_DIR/openssl-lifecycle-state.json" "$openssl_lifecycle_state"
assert_contains "mise bootstrap packages status" "installed"

# Exact Homebrew accepts mise-owned state for every user-visible operation.
for formula in "${formula_fixtures[@]}"; do
  assert_contains "'$brew' list --formula" "$formula"
  assert_succeed "'$brew' info '$formula'"
done
"$brew" postinstall ca-certificates
"$brew" postinstall openssl@3
"$brew" upgrade "${formula_fixtures[@]}"
"$brew" doctor >"$MISE_BREW_ORACLE_RESULT_DIR/macos-formula-doctor.txt" 2>&1 || true
if grep -E '(ca-certificates|openssl@3|node|kimi-code)' \
  "$MISE_BREW_ORACLE_RESULT_DIR/macos-formula-doctor.txt"; then
  brew_oracle_fail "Homebrew doctor rejected a mise-owned formula fixture"
fi
assert_formula_runtime

# Exact Homebrew can remove the mise-owned chain, then mise accepts the same
# chain installed by Homebrew without rewriting it.
for formula in kimi-code node openssl@3 ca-certificates; do
  "$brew" uninstall --formula --force --ignore-dependencies "$formula"
done
for formula in "${formula_fixtures[@]}"; do
  assert_fail "test -e '$MISE_SYSTEM_BREW_PREFIX/opt/$formula'"
done
for path in "${shared_fixture_paths[@]}"; do
  rm -rf "$path"
done
"$brew" install kimi-code
snapshot_formula_chain brew-formula-chain.snapshot
brew_oracle_diff \
  "$MISE_BREW_ORACLE_RESULT_DIR/brew-formula-chain.snapshot" \
  "$MISE_BREW_ORACLE_RESULT_DIR/mise-formula-chain.snapshot"
assert_contains "mise bootstrap packages status" "installed"
assert_contains "mise bootstrap packages apply --yes 2>&1" "already"
assert_formula_runtime

brew_oracle_complete test_system_install_brew_formula_lifecycle_macos_slow 5 "$MISE_SYSTEM_BREW_PREFIX"
